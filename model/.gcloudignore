# Controls what gets *uploaded* to Cloud Build on `gcloud builds submit`.
# This is separate from .dockerignore, which only filters what the Docker
# daemon sees after the upload -- without this file, the whole directory
# (including the 6+ GB .venv) is shipped on every deploy.
# Syntax is gitignore-style; must NOT exclude Dockerfile, pyproject.toml,
# uv.lock, src/, tests/, or train.py.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
checkpoints/
models/
.coverage
htmlcov/
.git/
.gcloudignore
